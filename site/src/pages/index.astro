---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Stats from '../components/Stats.astro'
import Apps from '../components/Apps.astro'
import Security from '../components/Security.astro'
import Planned from '../components/Planned.astro'
import Install from '../components/Install.astro'
import Footer from '../components/Footer.astro'
---

<Base
  title="RackDesk - a desktop for your Linux server, in the browser"
  description="RackDesk is one small program for a Linux server. Open it in a browser and manage the server with windows and apps instead of SSH. Open source."
  preview="One small program for a Linux server. Open it in a browser and manage the server with windows and apps instead of SSH. Open source."
>
  <Header />
  <main>
    <Hero />
    <Stats />
    <Apps />
    <Security />
    <Planned />
    <Install />
  </main>
  <Footer />
  <script src="../scripts/main.js"></script>
</Base>
