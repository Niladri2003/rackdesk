---
// The frame of every page: the head, and the coloured light behind the page.
import '../styles/site.css'

interface Props {
  title: string
  description?: string
  /** Text for link previews. Defaults to `description`. */
  preview?: string
  /** False keeps the page out of search engines. */
  index?: boolean
}
const { title, description, preview = description, index = true } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!index && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#080917" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {preview && <meta property="og:description" content={preview} />}
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/img/icon-180.png" />
    <link rel="preload" href="/fonts/Onest.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="sky" aria-hidden="true"><i></i><i></i><i></i></div>
    <slot />
  </body>
</html>
