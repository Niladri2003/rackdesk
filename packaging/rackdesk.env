# RackDesk settings. systemd reads this file for rackdeskd and for
# rackdesk-root. After a change, run:
#   sudo systemctl restart rackdeskd rackdesk-root
#
# A line that starts with # is not read. Remove the # to use a setting.

# The address the server listens on. The default is this machine only. Reach
# it over an SSH forward, a VPN or a reverse proxy. On any other address the
# server uses HTTPS, with a certificate it makes itself or with your own.
#RACKDESK_LISTEN=127.0.0.1:7171

# Your own certificate and key (PEM), in place of the one the server makes.
#RACKDESK_TLS_CERT=/etc/rackdesk/cert.pem
#RACKDESK_TLS_KEY=/etc/rackdesk/key.pem

# Set this when a reverse proxy with HTTPS forwards requests to RackDesk.
#RACKDESK_BEHIND_PROXY=true

# The folder the file browser shows as "/". Nothing above it can be read.
# The root program uses the same folder as its limit.
#RACKDESK_FILES_ROOT=/

# The terminal app. "off": no terminal. "as-user": rackdesk-root starts the
# shell as RACKDESK_SHELL_USER. "direct": the server starts it as its own
# user, with the limits of the server process.
#RACKDESK_TERMINAL=off

# The Linux user of a terminal shell in "as-user" mode.
#RACKDESK_SHELL_USER=

# Allows RACKDESK_SHELL_USER=root. A root terminal can do anything.
#RACKDESK_ALLOW_ROOT_SHELL=true

# Set this to use rackdesk-root for actions that need root. The root program
# service must be enabled too: sudo systemctl enable --now rackdesk-root
#RACKDESK_ROOT_SOCKET=/run/rackdesk/root.sock

# The user that runs the server. The installer sets it. The root program serves
# this user only.
#RACKDESK_USER=rackdesk
